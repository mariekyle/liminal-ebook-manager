# Copy this file to .env (same folder as docker-compose.yml) and fill in your values.
# .env is gitignored — real paths and secrets never get committed.

# Host path for library.db and covers/ (mounted at /app/data). Local disk, never NFS/SMB.
# Required: docker-compose refuses to start without it.
DATA_HOST_PATH=/path/to/liminal/data

# Host path to your ebook library (mounted into the container at /books).
# Required: docker-compose refuses to start without it.
BOOKS_HOST_PATH=/path/to/your/books

# Host path for database backups (mounted at /backups; point the backup_path setting there).
# Required: docker-compose refuses to start without it.
BACKUPS_HOST_PATH=/path/to/liminal/backups

# Optional: run a local build instead of the published image.
# LIMINAL_IMAGE=liminal-local
